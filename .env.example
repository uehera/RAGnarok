# PostgreSQL Metadata Store (Containerized or Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ragnarok"

# Optional Hosted Cloud LLM API Keys (Loaded if specified in config.toml)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Optional Local Model Endpoints (Ollama, vLLM, LM Studio)
OLLAMA_API_BASE="http://localhost:11434"
VLLM_API_BASE="http://localhost:8000/v1"

# DeepEval Telemetry and Cache Settings
DEEPEVAL_TELEMETRY_OPT_OUT="Y"
DEEPEVAL_CACHE_FOLDER=".pytest_cache/deepeval"
