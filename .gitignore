# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
wheels/
*.whl
*.so

# Virtual environment
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment secrets & credentials
.env
*.env
!.env.example
.env.local
.env.*.local

# Database files & locks (DuckDB)
*.duckdb
*.duckdb.wal
*.duckdb.tmp

# Runtime data & search indexes (Never commit - generated via scripts/verify_setup.py)
data/
/data/
data/**

# Model weights & caches (NEVER commit - local model storage)
models/
/models/
models/**
*.onnx
*.safetensors
*.bin
*.pt
*.pth
fastembed_cache/

# Explicitly ensure benchmark test data is NOT ignored
!tests/data/
!tests/data/**

# Testing, linting & coverage caches
.pytest_cache/
.ruff_cache/
.deepeval/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
coverage.xml

# Editor & OS artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Developer & agent logs/workspace
.agents/
dev/
*.log
logs/
